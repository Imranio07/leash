# Copy to .env and fill in. .env is gitignored; never commit it.

# --- LLM (agent + /translate service) ---
# gemini | groq
LLM_PROVIDER=gemini
# Empty = provider default (gemini: gemini-2.5-flash, groq: llama-3.3-70b-versatile)
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Solana (devnet only) ---
RPC_URL=https://api.devnet.solana.com
# Token the vault holds. Empty = `npm run setup` creates a 6-decimal test mint and writes it here.
# Circle devnet USDC is 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU (get it at faucet.circle.com).
USDC_MINT=
# Vault owner for the CLI scripts (the dashboard uses Phantom instead).
OWNER_KEYPAIR=~/.config/solana/id.json
# Agent key. Lives in keys/ (gitignored). Holds a little SOL for fees, never USDC.
AGENT_KEYPAIR=keys/agent.json
# Vault the agent pays from. Written by `npm run setup`. The agent never reads the owner's key.
LEASH_VAULT=

# --- Paid services ---
SERVICES_URL=http://localhost:4021
SERVICES_PORT=4021

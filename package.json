{
  "name": "leash",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk",
    "services",
    "agent",
    "app",
    "mcp"
  ],
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "owner": "tsx scripts/owner.ts",
    "services": "tsx services/src/server.ts",
    "agent": "tsx agent/src/agent.ts",
    "pay": "tsx agent/src/manual.ts pay",
    "call": "tsx agent/src/manual.ts call",
    "budget": "tsx agent/src/manual.ts budget",
    "sync-idl": "cp target/idl/leash.json sdk/src/idl/leash.json && cp target/types/leash.ts sdk/src/idl/leash.ts",
    "typecheck": "tsc --noEmit -p .",
    "app": "npm run dev --workspace app",
    "app:build": "npm run build --workspace app",
    "fresh": "tsx scripts/fresh.ts",
    "demo": "tsx scripts/demo.ts",
    "mcp": "tsx mcp/src/server.ts",
    "token-metadata": "tsx scripts/token-metadata.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
